# ============================================================
# SisiCalendar 环境变量样例
# 复制为 .env 后按需修改。.env 不入库,SMTP 密码不得写进镜像或代码。
# ============================================================

# ---------- 运行与数据 ----------
# 容器内固定 /data;本机直接运行时可用 ./data
DATA_DIR=/data
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---------- 管理员与安全 ----------
ADMIN_USERNAME=admin
# 二选一注入凭据;两者都留空时,首次启动会随机生成密码并打印到日志一次,
# 哈希保存在 ${DATA_DIR}/admin.hash,之后不再变化。
# ADMIN_PASSWORD=change-me-before-use
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$....
# 会话签名密钥;留空时首次启动生成并写入 ${DATA_DIR}/session_secret
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=43200

# ---------- 日历默认值 ----------
CALENDAR_NAME=Sisi Calendar
DEFAULT_TIMEZONE=Australia/Brisbane
DEFAULT_EVENT_DURATION_MINUTES=60
SUBSCRIPTION_URL=https://sisi-laptop.tail921448.ts.net/calendar
# 订阅缓存时间(秒),对应 Cache-Control: private, max-age=N, must-revalidate
FEED_CACHE_SECONDS=300

# ---------- SMTP 发信 ----------
# 密码只通过环境变量或 Docker Secret 注入,绝不写入 SQLite
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Sisi Calendar
SMTP_TIMEOUT_SECONDS=30

# ---------- 邮件重试策略 ----------
MAIL_MAX_ATTEMPTS=5
# 单位分钟,按顺序对应第 1..N 次重试等待
MAIL_BACKOFF_MINUTES=1,5,15,60,180
# 导出版本快照在全部任务终结后的保留天数
EXPORT_SNAPSHOT_RETENTION_DAYS=30
# 后台任务:ICS 修复与邮件队列轮询间隔(秒)
SCHEDULER_INTERVAL_SECONDS=60

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=14
