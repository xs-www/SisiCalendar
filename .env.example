# ============================================================
# SisiCalendar 环境变量样例
# 复制为 .env 后按需修改。.env 不入库,SMTP 密码不得写进镜像或代码。
# ============================================================

# ---------- 运行与数据 ----------
# 容器内固定 /data;本机直接运行时可用 ./data
DATA_DIR=/data
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---------- 管理员与安全 ----------
# 家庭版:这里给出的是**首位家庭管理员**(家长)的凭据。老库升级时,原有日程会全部
# 归入他的私人日历,历史外部收件人保留原收信范围;旧无令牌 /calendar 订阅已取消。
# 其余家人不进 .env,由他用「成员」页生成邀请码,家人在 /calendar/register 自助注册。
ADMIN_USERNAME=admin
# 二选一注入凭据;两者都留空时,首次启动会随机生成密码并打印到日志一次,
# 哈希保存在 ${DATA_DIR}/admin.hash,之后不再变化。
# ADMIN_PASSWORD=change-me-before-use
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$....
# 会话签名密钥;留空时首次启动生成并写入 ${DATA_DIR}/session_secret(推荐留空)。
# 成员界面一旦开放给家庭网络(见《部署与运维》第 3 节),这里就不要填短口令:
# 它盖住文件里的 64 字符随机密钥,等于把会话伪造风险留给整个 tailnet。
# 运行后不得随意删除/轮换密钥:它还用于派生每个账号的固定订阅地址与邮箱验证码哈希。
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=43200

# ---------- 日历默认值 ----------
CALENDAR_NAME=Sisi Calendar
DEFAULT_TIMEZONE=Australia/Brisbane
DEFAULT_EVENT_DURATION_MINUTES=60
# 公开面的正式基地址(含路径前缀)。整套公开路由都挂在这个前缀下:
# 注册页 /calendar/register、登录页 /calendar/login、订阅地址 /calendar/<令牌>.ics。
# 本机管理面不受影响,仍是 http://localhost:<端口>/admin(裸路径)。
# 里面的路径部分就是挂载点,Tailscale Serve 必须挂到**完全一样**的路径上。
PUBLIC_BASE_URL=https://sisi-laptop.tail921448.ts.net/calendar
# 宿主机上发布的端口(compose.yaml 是 443,compose.nas.yaml 默认 18443)。
# 只影响设置页:生成 `tailscale serve` 命令、以及「检测宿主端口映射」时连哪个端口。
# 它**不改变**容器监听(PORT=8000);改了宿主的 ports 就要同步改这里,否则检测会误报。
HOST_PORT=443
# 订阅缓存时间(秒),对应 Cache-Control: private, max-age=N, must-revalidate
FEED_CACHE_SECONDS=300

# ---------- 邮箱验证 ----------
# 验证码有效期(秒)、单个验证码允许的错误次数、两次重发之间的冷却(秒)
EMAIL_CODE_TTL_SECONDS=1800
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60

# ---------- SMTP 发信 ----------
# 密码只通过 SMTP_PASSWORD 环境变量注入,绝不写入 SQLite(当前未实现 SMTP_PASSWORD_FILE)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Sisi Calendar
SMTP_TIMEOUT_SECONDS=30

# ---------- 邮件重试策略 ----------
MAIL_MAX_ATTEMPTS=5
# 单位分钟,按顺序对应第 1..N 次重试等待
MAIL_BACKOFF_MINUTES=1,5,15,60,180
# 导出版本快照在全部任务终结后的保留天数
EXPORT_SNAPSHOT_RETENTION_DAYS=30
# 后台任务:ICS 修复与邮件队列轮询间隔(秒)
SCHEDULER_INTERVAL_SECONDS=60

# ---------- 远程 Agent 接入 ----------
# 供本机之外的自动化 Agent 通过 HTTP 新建日程(POST /api/agent/events)。
# 留空则整个 /api/agent 返回 404,等同不存在。可用逗号分隔配置多个以便轮换。
# 生成方式:python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
# 每个令牌每分钟允许的请求数
AGENT_RATE_LIMIT_PER_MINUTE=60

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=14
